# ── Required ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Same JWT secret as the main dashboard (same user accounts, same DB)
JWT_SECRET_KEY=your_jwt_secret

# ── Lead Finder: users' own tool keys ─────────────────────────────────────────
# Every user adds their own Hunter, Serper, Reoon and AI keys in Settings > Tools; they are stored encrypted with this
# secret. Create one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe: if it is lost, saved keys can't be read and users add them again.
# Also run backend/migrations/001_prospect_api_keys.sql once in the Supabase SQL editor.
KEYS_ENCRYPTION_KEY=

# ── Optional: auth emails ─────────────────────────────────────────────────────
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=hello@yourdomain.com
FRONTEND_URL=http://localhost:3001
